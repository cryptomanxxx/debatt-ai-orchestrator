{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "debatt-ai-bootloops",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "**/__pycache__/**"
    ]
  },
  "observability": {
    "enabled": true
  }
}
