{
  "name": "debatt-ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test tests/*.test.ts && npm run test:research",
    "test:bootloops": "python3 -m unittest discover -s tests-python && node --test tests-bootloops/*.test.ts",
    "profile:bootloops": "python3 scripts/profile_bootloops.py",
    "test:workers": "node --test tests-workers/*.test.ts",
    "dev:workers": "wrangler dev",
    "check:workers": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy:workers": "wrangler deploy",
    "prepare:bootloops:worker": "python3 scripts/prepare_bootloops_worker.py",
    "check:bootloops:worker": "npm run prepare:bootloops:worker && cd bootloops-worker && uvx --from workers-py==1.17.6 pywrangler deploy --dry-run --outdir .worker-build",
    "deploy:bootloops:worker": "npm run prepare:bootloops:worker && cd bootloops-worker && uvx --from workers-py==1.17.6 pywrangler deploy",
    "deploy:workers:bootloops": "wrangler deploy --config wrangler.bootloops.jsonc",
    "check:workers:bootloops": "wrangler deploy --config wrangler.bootloops.jsonc --dry-run --outdir .worker-build-bootloops",
    "test:bootloops:worker": "node --test tests-python-workers/*.test.ts",
    "research:catalog": "node research/show-catalog.mjs",
    "test:research": "node --test tests-research/*.test.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261001.0-alpha",
    "wrangler": "4.147.0"
  }
}
