{
  "name": "debatt-ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test tests/*.test.ts",
    "test:workers": "node --test tests-workers/*.test.ts",
    "dev:workers": "wrangler dev",
    "check:workers": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy:workers": "wrangler deploy"
  },
  "devDependencies": {
    "miniflare": "5.20261001.0-alpha",
    "wrangler": "4.147.0"
  }
}
